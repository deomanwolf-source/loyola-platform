NODE_ENV=production
PORT=5002
APP_NAME=edutrack
FRONTEND_ROOT=./public
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_edutrack_database_user
DB_PASSWORD=your_edutrack_database_password
DB_NAME=your_edutrack_database_name
# Set to 1 to require NIC-number sign in and reject email-based login.
# Leave unset until every account has a NIC number assigned, or users will be locked out.
#LOGIN_REQUIRE_NIC=1
# Optional dedicated account-management database. When ACCOUNTS_DB_NAME is set,
# the account registry and account audit log are stored in this separate database.
# Leave unset to keep them in the main EduTrack database.
#ACCOUNTS_DB_HOST=localhost
#ACCOUNTS_DB_PORT=3306
#ACCOUNTS_DB_USER=your_accounts_database_user
#ACCOUNTS_DB_PASSWORD=your_accounts_database_password
#ACCOUNTS_DB_NAME=your_accounts_database_name
JWT_SECRET=use_the_same_long_secret_as_the_website_app
EDUTRACK_SYNC_SECRET=use_the_same_sync_secret_as_the_website_app
ALLOWED_ORIGINS=https://loyolacollege.lk,https://www.loyolacollege.lk,https://edutrack.loyolacollege.lk
PUBLIC_API_URL=https://edutrack.loyolacollege.lk
